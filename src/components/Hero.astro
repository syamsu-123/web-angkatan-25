---
// Bagian 1: Hero
---
<section class="hero">
  <div class="hero-content">
    <img class="reveal" src="/images/logo.png" alt="Logo SMK Al-Ittihad" width="200" />
    <h1 class="reveal">SMK AL-ITTIHAD</h1>
    <p class="reveal">Sekolah Menengah Kejuruan Al-Ittihad · Karangtengah, Cianjur</p>
    <a class="btn reveal" href="#about">Kenali Kami</a>
  </div>
</section>
<style>
  .hero{position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(160deg,var(--g1),var(--g2) 70%,#d4d4d4)}
  .hero-content{position:relative;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 20px;width:100%}
  img{
    width:min(200px,45vw);
    height:auto;
    filter:drop-shadow(0 8px 18px rgba(0,0,0,.24));
    transition:
      opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.2s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  img.active{
    animation: heroLogoFloat 6.5s ease-in-out 1.1s infinite;
  }
  img.active:hover{
    filter:drop-shadow(0 14px 26px rgba(0,0,0,.32));
  }
  h1{
    font-size:clamp(40px,10vw,110px);
    letter-spacing:6px;
    margin-top:20px;
    text-shadow:0 2px 14px rgba(0,0,0,.18);
    transition:
      opacity 1.15s cubic-bezier(0.16, 1, 0.3, 1),
      transform 1.25s cubic-bezier(0.16, 1, 0.3, 1),
      filter 1.1s cubic-bezier(0.16, 1, 0.3, 1),
      letter-spacing 1.4s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }
  h1.active{
    letter-spacing:2px;
  }
  p{font-family:'Cormorant Garamond',serif;font-size:clamp(16px,3vw,22px);margin:8px 0 28px;text-shadow:0 1px 8px rgba(0,0,0,.2)}
  .btn{
    position:relative;
    overflow:hidden;
    padding:12px 28px;
    border:1px solid rgba(255,255,255,.85);
    border-radius:99px;
    color:#fff;
    text-decoration:none;
    background:var(--card);
    backdrop-filter:blur(8px);
    -webkit-backdrop-filter:blur(8px);
    box-shadow:0 6px 20px rgba(0,0,0,.12), inset 0 1px 0 rgba(255,255,255,.25);
    transition:
      opacity 1.05s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      filter 1.05s cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
      transform 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.55s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn::before{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(115deg, transparent 20%, rgba(255,255,255,.32) 50%, transparent 80%);
    transform:translateX(-125%) skewX(-18deg);
    transition:transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events:none;
  }
  .btn.active:hover{
    transform:translate3d(0, -3px, 0) scale(1.03);
    background:rgba(255,255,255,.22);
    border-color:#fff;
    box-shadow:0 12px 28px rgba(0,0,0,.2), 0 0 18px rgba(255,255,255,.18), inset 0 1px 0 rgba(255,255,255,.4);
  }
  .btn.active:hover::before{
    transform:translateX(125%) skewX(-18deg);
  }
  .btn.active:active{
    transform:translate3d(0, -1px, 0) scale(0.99);
    transition-duration:0.15s;
  }
  @keyframes heroLogoFloat {
    0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
    50% { transform: translate3d(0, -7px, 0) scale(1.015); }
  }
  @media (prefers-reduced-motion: reduce) {
    img.active { animation: none; }
    h1 { letter-spacing: 2px; }
  }
</style>
