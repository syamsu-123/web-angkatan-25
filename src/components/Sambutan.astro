---
// Bagian 3: Sambutan (isi teks ada di src/data/sambutan.ts)
import { sambutan } from '../data/sambutan';
---
<section class="sambutan">
  <img src="/images/kh-kamali.jpg" alt={sambutan.nama} loading="lazy" />
  <div class="txt reveal">
    <p class="kecil">sambutan</p>
    <p class="nama">{sambutan.nama}</p>
    <p class="jabatan">{sambutan.jabatan}</p>
    {sambutan.paragraf.map((t) => <p class="isi">{t}</p>)}
  </div>
</section>
<style>
  .sambutan{display:grid;grid-template-columns:minmax(220px,1fr) 2fr;background:linear-gradient(120deg,#3fa57a,#7d9a8c);overflow:hidden}
  img{
    width:100%;
    height:100%;
    min-height:360px;
    object-fit:cover;
    transform:scale(1.015);
    filter:saturate(0.98) contrast(1.02);
    transition:
      transform 1.35s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .sambutan:hover img{
    transform:scale(1.045);
    filter:saturate(1.05) contrast(1.04);
  }
  .txt{padding:36px clamp(20px,4vw,48px)}
  p{margin:0}
  .kecil{font-size:clamp(22px,3vw,32px);font-weight:700}
  .nama{font-size:clamp(28px,5vw,46px);font-weight:700;line-height:1.1}
  .jabatan{font-weight:700;margin:4px 0 16px}
  .isi{font-size:15px;line-height:1.7;margin-bottom:10px;opacity:.95}

  /* Stagger cascade halus untuk setiap paragraf di dalam blok sambutan */
  .txt.reveal p{
    opacity: 0;
    transform: translate3d(0, 18px, 0);
    filter: blur(4px);
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.95s cubic-bezier(0.16, 1, 0.3, 1),
      filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .txt.reveal.active p{
    opacity: 1;
    transform: translate3d(0, 0, 0);
    filter: blur(0px);
  }
  .txt.reveal.active .isi{
    opacity: .95;
  }
  .txt.reveal.active p:nth-child(1){ transition-delay: 80ms; }
  .txt.reveal.active p:nth-child(2){ transition-delay: 160ms; }
  .txt.reveal.active p:nth-child(3){ transition-delay: 240ms; }
  .txt.reveal.active p:nth-child(4){ transition-delay: 320ms; }
  .txt.reveal.active p:nth-child(5){ transition-delay: 400ms; }
  .txt.reveal.active p:nth-child(6){ transition-delay: 480ms; }
  .txt.reveal.active p:nth-child(7){ transition-delay: 560ms; }
  .txt.reveal.active p:nth-child(8){ transition-delay: 640ms; }

  @media(max-width:720px){.sambutan{grid-template-columns:1fr}img{height:320px}}
  @media (prefers-reduced-motion: reduce) {
    img, .sambutan:hover img, .txt.reveal p {
      transform: none;
      filter: none;
      transition: none;
      opacity: 1;
    }
  }
</style>
