---
// Bagian 3: Sambutan (isi teks ada di src/data/sambutan.ts)
import { sambutan } from '../data/sambutan';
---
<section class="sambutan">
  <img src="/images/kh-kamali.jpg" alt={sambutan.nama} loading="lazy" />
  <div class="txt reveal">
    <p class="kecil">sambutan</p>
    <p class="nama">{sambutan.nama}</p>
    <p class="jabatan">{sambutan.jabatan}</p>
    {sambutan.paragraf.map((t) => <p class="isi">{t}</p>)}
  </div>
</section>
<style>
  .sambutan{display:grid;grid-template-columns:minmax(220px,1fr) 2fr;background:linear-gradient(120deg,#3fa57a,#7d9a8c)}
  img{width:100%;height:100%;min-height:360px;object-fit:cover}
  .txt{padding:36px clamp(20px,4vw,48px)}
  p{margin:0}
  .kecil{font-size:clamp(22px,3vw,32px);font-weight:700}
  .nama{font-size:clamp(28px,5vw,46px);font-weight:700;line-height:1.1}
  .jabatan{font-weight:700;margin:4px 0 16px}
  .isi{font-size:15px;line-height:1.7;margin-bottom:10px;opacity:.95}
  @media(max-width:720px){.sambutan{grid-template-columns:1fr}img{height:320px}}
</style>
