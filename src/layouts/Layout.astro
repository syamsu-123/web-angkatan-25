---
import '../styles/global.css';
import PaperPlaneAnimation from '../components/PaperPlaneAnimation.jsx';
const { title = 'SMK Al-Ittihad', description = 'Web angkatan SMK Al-Ittihad, Karangtengah, Cianjur' } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Cormorant+Garamond:wght@400;600&family=Open+Sans:wght@400;700&display=swap" rel="stylesheet" />
    <style is:global>
      /* Efek halaman seperti kertas ketarik saat scroll */
      .page {
        --pull-opacity: 0;
        transform-origin: 50% 50%;
        will-change: transform;
        position: relative;
        z-index: 30;
        backface-visibility: hidden;
        transition: box-shadow 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .page.pull {
        box-shadow: 0 28px 70px rgba(0, 0, 0, 0.38);
      }
      .page::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: var(--pull-opacity, 0);
        transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        background:
          linear-gradient(180deg, rgba(0, 0, 0, 0.3), rgba(255, 255, 255, 0.04) 4%, transparent 10%) top / 100% 100% no-repeat,
          linear-gradient(0deg, rgba(0, 0, 0, 0.3), rgba(255, 255, 255, 0.04) 4%, transparent 10%) bottom / 100% 100% no-repeat;
      }
      .page.pull::after {
        opacity: var(--pull-opacity, 1);
      }
      .crease {
        position: fixed;
        left: 0;
        right: 0;
        height: 18px;
        pointer-events: none;
        z-index: 55;
        opacity: 0;
        transform: translate3d(0, -50%, 0);
        will-change: transform, opacity, top;
        border-top: 1px dashed rgba(255, 255, 255, 0.55);
        background: linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.14) 0%,
          rgba(0, 0, 0, 0.18) 35%,
          transparent 100%
        );
        filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.35));
        transition: opacity 0.38s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .crease.show {
        opacity: var(--crease-opacity, 0.85);
      }
      @media (prefers-reduced-motion: reduce) {
        .page, .page::after, .crease {
          transform: none !important;
          opacity: 1;
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="crease" aria-hidden="true"></div>
    <main class="page">
      <slot />
    </main>
    <PaperPlaneAnimation client:load />
    <script is:inline>
      // Berikan stagger delay otomatis untuk elemen .reveal yang bersaudara di tiap section
      document.querySelectorAll('section').forEach((section) => {
        const reveals = section.querySelectorAll('.reveal');
        reveals.forEach((el, idx) => {
          if (!el.style.getPropertyValue('--reveal-delay')) {
            el.style.setProperty('--reveal-delay', `${idx * 130}ms`);
          }
        });
      });

      // Animasi fade-in saat section masuk layar
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -4% 0px' });

      // Hanya jalankan animasi jika user tidak prefer reduced motion
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion) {
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      } else {
        // Nonaktifkan semua animasi reveal
        document.querySelectorAll('.reveal').forEach((el) => {
          el.classList.add('active');
        });
      }

      // Efek halaman ketarik seperti kertas saat scroll dengan spring physics halus (frame-rate independent)
      const page = document.querySelector('.page');
      const crease = document.querySelector('.crease');

      if (page && crease && !reduceMotion) {
        let lastY = window.scrollY;
        let targetVel = 0;
        let smoothVel = 0;
        let displayVel = 0;
        let creasePos = 50;
        let rafP = 0;
        let lastTime = performance.now();

        const loop = (now) => {
          const dt = Math.min(0.05, Math.max(0.001, (now - lastTime) / 1000));
          lastTime = now;

          // Spring-damping halus berbasis waktu (frame-rate independent)
          const followRate = 1 - Math.exp(-14 * dt);
          const displayRate = 1 - Math.exp(-10 * dt);
          const decayRate = Math.exp(-9.5 * dt);

          smoothVel += (targetVel - smoothVel) * followRate;
          displayVel += (smoothVel - displayVel) * displayRate;
          targetVel *= decayRate;

          const s = Math.max(-1, Math.min(1, displayVel / 52));
          const absS = Math.abs(s);

          // Kurva non-linear lembut agar tarikan terasa organik seperti kertas asli
          const easedS = Math.sign(s) * Math.pow(absS, 0.85);
          const stretch = Math.abs(easedS) * 0.042;
          const translateY = easedS * -7.5;
          const skew = easedS * 0.48;

          // Transform origin bergeser halus mengikuti arah tarikan
          const originY = 50 - easedS * 18;
          page.style.transformOrigin = `50% ${originY.toFixed(2)}%`;
          page.style.transform = `translate3d(0, ${translateY.toFixed(3)}px, 0) scaleY(${(1 + stretch).toFixed(5)}) skewY(${skew.toFixed(3)}deg)`;

          // Posisi garis lipatan kertas (crease) bergerak mulus tanpa melompat
          const targetCrease = s >= 0 ? 10 + absS * 4 : 88 - absS * 4;
          creasePos += (targetCrease - creasePos) * (1 - Math.exp(-12 * dt));
          crease.style.top = `${creasePos.toFixed(2)}vh`;

          const pullStrength = Math.min(1, absS * 2.2);
          page.style.setProperty('--pull-opacity', pullStrength.toFixed(3));
          crease.style.setProperty('--crease-opacity', (pullStrength * 0.88).toFixed(3));

          if (absS > 0.035) {
            page.classList.add('pull');
            crease.classList.add('show');
          } else {
            page.classList.remove('pull');
            crease.classList.remove('show');
          }

          if (Math.abs(targetVel) > 0.02 || Math.abs(smoothVel) > 0.02 || Math.abs(displayVel) > 0.02) {
            rafP = requestAnimationFrame(loop);
          } else {
            targetVel = 0;
            smoothVel = 0;
            displayVel = 0;
            rafP = 0;
            page.style.transform = '';
            page.style.transformOrigin = '50% 50%';
            page.style.setProperty('--pull-opacity', '0');
            crease.style.setProperty('--crease-opacity', '0');
            page.classList.remove('pull');
            crease.classList.remove('show');
          }
        };

        const onScroll = () => {
          const y = window.scrollY;
          const delta = y - lastY;
          lastY = y;
          // Batasi lonjakan ekstrim agar tetap mulus di mouse wheel maupun touchpad
          targetVel = Math.max(-140, Math.min(140, targetVel + delta * 0.85));
          if (!rafP) {
            lastTime = performance.now();
            rafP = requestAnimationFrame(loop);
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
